# whatsapp-bridge configuration.
# Copy to .env (which is git-ignored) and fill in real values, OR export these
# variables in your shell before running. A local .env is loaded automatically.

# Where inbound WhatsApp messages are POSTed (Erda's HTTP inbound endpoint).
ERDA_INBOUND_URL=http://127.0.0.1:5167/channel/whatsapp/in

# host:port the bridge's outbound HTTP server binds to. Localhost ONLY.
BRIDGE_LISTEN=127.0.0.1:8088

# Shared secret. Sent on inbound POSTs and required on /send as header
# X-Bridge-Secret. Use a long random string.
SHARED_SECRET=change-me-to-a-long-random-string

# The ONLY sender whose messages are relayed. Bare user part is compared, so
# device/agent suffixes are ignored. Everything else is dropped.
OWNER_JID=4915123456789@s.whatsapp.net

# Path to the whatsmeow SQLite session store (created on first run).
SESSION_DB=./whatsmeow-session.db

# Directory for downloaded media (audio/images). Created if missing.
MEDIA_DIR=/tmp/erda-bridge
