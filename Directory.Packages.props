<Project>

  <!-- Central Package Management: every NuGet version for the solution lives here, so the four
       projects can never drift apart (csproj files carry PackageReference without Version). -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="Microsoft Agent Framework + AI abstractions">
    <PackageVersion Include="Microsoft.Agents.AI" Version="1.28.0" />
    <PackageVersion Include="Microsoft.Agents.AI.OpenAI" Version="1.28.0" />
    <PackageVersion Include="Microsoft.Agents.AI.Workflows" Version="1.28.0" />
    <PackageVersion Include="Microsoft.Agents.AI.Hosting" Version="1.28.0-preview.261106.1" />
    <PackageVersion Include="Microsoft.Extensions.AI" Version="11.0.1" />
    <!-- Explicit so the OpenAI IChatClient adapter matches MEAI 11 (MAF alone would pull 10.11). -->
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="11.0.1" />
    <PackageVersion Include="OpenAI" Version="2.15.0" />
  </ItemGroup>

  <ItemGroup Label="Platform">
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="11.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Options.DataAnnotations" Version="11.0.0" />
    <PackageVersion Include="Cronos" Version="0.13.0" />
    <PackageVersion Include="Seq.Api" Version="2026.2.0" />
  </ItemGroup>

  <ItemGroup Label="Logging + tracing">
    <PackageVersion Include="OpenTelemetry.Exporter.Console" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0" />
    <PackageVersion Include="Serilog.AspNetCore" Version="11.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="Serilog.Sinks.Seq" Version="9.2.0" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <!-- xunit.v3 runs on Microsoft.Testing.Platform (global.json "test.runner"); no VSTest adapter. -->
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>

</Project>
