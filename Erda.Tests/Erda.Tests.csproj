<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- xUnit1051 (pass TestContext.Current.CancellationToken) is advisory; these tests are short and
         in-process, so threading the token through every call is noise. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <!-- The API tests touch ASP.NET types (endpoint filters, HttpContext, IConfiguration). A project
       reference to the Web SDK app does not flow its framework reference, so declare it here too. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Erda.Core\Erda.Core.csproj" />
    <ProjectReference Include="..\Erda.Agents\Erda.Agents.csproj" />
    <ProjectReference Include="..\Erda.Server\Erda.Server.csproj" />
  </ItemGroup>

</Project>