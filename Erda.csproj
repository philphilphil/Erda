<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>erda-personal-agent</UserSecretsId>
  </PropertyGroup>

  <!-- The test project lives in a subfolder; keep its sources out of this Web project's glob. -->
  <ItemGroup>
    <Compile Remove="Erda.Tests/**/*.cs" />
    <Content Remove="Erda.Tests/**/*" />
    <None Remove="Erda.Tests/**/*" />
  </ItemGroup>

  <ItemGroup>
    <!-- Core Microsoft Agent Framework (stable 1.8.0 train) -->
    <PackageReference Include="Cronos" Version="0.13.0" />
    <PackageReference Include="Microsoft.Agents.AI" Version="1.8.0" />
    <PackageReference Include="Microsoft.Agents.AI.OpenAI" Version="1.8.0" />
    <PackageReference Include="Microsoft.Agents.AI.Workflows" Version="1.8.0" />

    <!-- Hosting + DevUI (preview/alpha on the same 1.8.0 train) -->
    <PackageReference Include="Microsoft.Agents.AI.Hosting" Version="1.8.0-preview.260528.1" />
    <PackageReference Include="Microsoft.Agents.AI.Hosting.OpenAI" Version="1.8.0-alpha.260528.1" />
    <PackageReference Include="Microsoft.Agents.AI.DevUI" Version="1.8.0-preview.260528.1" />

    <!-- Microsoft.Extensions.AI: AIFunctionFactory, ChatMessage, ChatRole -->
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.6.0" />

    <!-- Azure OpenAI client (Foundry endpoint, key auth) for the chat agent -->
    <PackageReference Include="Azure.AI.OpenAI" Version="2.9.0-beta.1" />

    <!-- Official OpenAI SDK: used ONLY for audio transcription (platform key) -->
    <PackageReference Include="OpenAI" Version="2.10.0" />
    <PackageReference Include="OpenTelemetry.Exporter.Console" Version="1.15.3" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.15.3" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.15.3" />
    <PackageReference Include="Seq.Api" Version="2025.2.2" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.Seq" Version="9.1.0" />
  </ItemGroup>

</Project>
