# Stack config for the Jetson Docker deployment (docker-compose.yml).
# Copy to .env (git-ignored) next to docker-compose.yml and fill in. Compose reads .env
# automatically. In Komodo, set these as the Stack's environment/secrets instead.

# --- Host paths (MUST be absolute; compose does NOT expand ~) -----------------
# Logged-in Codex subscription session dir (after `codex login` on the Jetson host).
CODEX_DIR=/home/phil/.codex
# Obsidian vault dir on the host, kept in sync by Syncthing/obsidian-git/etc.
VAULT_DIR=/home/phil/vault

# --- Control panel (LAN-only web UI at http://<jetson-ip>:5167) ---------------
# Host interface the panel binds to. 0.0.0.0 = reachable anywhere on your home LAN.
# Set a specific LAN IP (e.g. 192.168.1.50) to restrict, or 127.0.0.1 for local-only.
PANEL_BIND=0.0.0.0
# Optional single-user login. Leave PANEL_PASSWORD blank to keep the panel open on the LAN
# (the default); set it to require a cookie login. PANEL_USERNAME defaults to "admin".
PANEL_USERNAME=admin
PANEL_PASSWORD=

# --- WhatsApp -----------------------------------------------------------------
# Long random string; the SAME value is used by the bridge and Erda.
SHARED_SECRET=
# Owner JID for the bridge whitelist, e.g. 4915123456789@s.whatsapp.net
OWNER_JID=
# Same owner as an E.164 number for Erda, e.g. +4915123456789
OWNER_NUMBER=

# --- Azure OpenAI (chat, gpt-5-mini) ------------------------------------------
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=

# --- OpenAI platform (transcription only; stripped from the Codex subprocess) -
OPENAI_API_KEY=

# --- Seq (central log server; error-watch reads from here) --------------------
SEQ_SERVER_URL=https://seq.phib.io
SEQ_API_KEY=
