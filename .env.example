# Erda configuration — the single source of truth (env-only).
#
# Copy to .env (git-ignored). Both docker-compose (prod, via `env_file`) and `make dev` (which sources
# this file) read the SAME app-native keys below. NOTHING has an in-code default: every value here
# must be set, and a missing one stops the app at startup naming the key. Bool switches are OFF when
# absent — turn on what you want. Feature settings (WhatsApp, ErrorWatch, Reminders, Browser) are
# required only when that feature's `Enabled` switch is on.
#
# Values here are the conventional ones / placeholders. Container paths (/vault, /media, /data) suit
# the Jetson deployment; on the dev Mac use real local paths. In Komodo, set these same keys as the
# Stack's environment/secrets.

# ── Credentials (required) ─────────────────────────────────────────────────────
# Azure AI Foundry chat model + OpenAI-platform key for transcription.
AZURE_OPENAI_ENDPOINT=https://your-resource.services.ai.azure.com/
AZURE_OPENAI_API_KEY=
OPENAI_API_KEY=

# ── Core (required) ────────────────────────────────────────────────────────────
Erda__VaultPath=/vault                       # Obsidian vault root (dev: /Users/you/Notes)
Erda__DbPath=/data/erda/erda.db              # SQLite state file (dev: an absolute local path)

# ── Models & Codex (required) ──────────────────────────────────────────────────
Erda__ChatDeployment=gpt-5-mini              # Azure Foundry deployment name for the chat model
Erda__TranscribeModel=gpt-4o-transcribe      # OpenAI STT model (gpt-4o-mini-transcribe is cheaper)
Erda__CodexModel=gpt-5.5                      # codex exec -m (must be a model the ChatGPT sub supports; not gpt-5-codex)
Erda__CodexReasoningEffort=high              # low / medium / high
Erda__CodexTimeout=00:03:00                  # max wall-clock for one codex exec (hh:mm:ss)
Erda__CodexExecutable=codex                  # codex CLI (path or name on PATH)
Erda__VoiceMemoSubfolder=VoiceMemos          # vault-relative folder for processed voice memos

# ── WhatsApp (Enabled is a switch; the four below are required only when Enabled=true) ──
WhatsApp__Enabled=true
WhatsApp__OwnerNumber=+490000000000          # your number, E.164
WhatsApp__BridgeUrl=http://whatsapp-bridge:8088   # dev: http://127.0.0.1:8088
WhatsApp__SharedSecret=                       # long random string; SAME value the bridge uses
WhatsApp__MediaTempDir=/media                # dev: /tmp/erda-bridge
# WhatsApp__DevPrefix=@dev                    # optional: only when running a dev instance alongside prod

# ── Seq (optional; blank ServerUrl ⇒ error-watch + log shipping are off) ────────
Seq__ServerUrl=https://seq.example.com
Seq__ApiKey=
Seq__IngestToErda=true                       # ship Erda's own logs to Seq (switch; absent ⇒ off)

# ── Error watch (Enabled is a switch; the three below required only when Enabled=true) ──
ErrorWatch__Enabled=true
ErrorWatch__PollInterval=00:15:00            # how often to poll Seq (hh:mm:ss)
ErrorWatch__MinLevel=Error                   # minimum Seq level to alert on
ErrorWatch__MaxAlertsPerPoll=5               # per-poll cap (prevents alert storms)
ErrorWatch__AnalyzeWithCodex=true            # analyse each error with Codex vs. send raw (switch)

# ── Reminders (Enabled is a switch; settings below required only when Enabled=true) ──
Reminders__Enabled=true
Reminders__NotePath=Atlas/AI/Erda/Reminders.md   # vault-relative note holding the reminder tables
Reminders__TimeZone=Europe/Berlin            # IANA timezone the `when` column is read in
Reminders__PollInterval=00:01:00             # how often to check for due reminders (hh:mm:ss)
Reminders__OverdueGrace=24:00:00             # how late a one-shot may still fire (e.g. after downtime)
Reminders__NotifyOnError=true                # WhatsApp note on a parse/dispatch failure (switch)
Reminders__PreScriptEnabled=true             # allow scheduled-prompt pre-run scripts (switch)
Reminders__PreScriptTimeout=00:00:30         # required when PreScriptEnabled: kill a script after this
Reminders__PreScriptMaxOutputChars=8000      # required when PreScriptEnabled: cap injected stdout

# ── Observability (switches; absent ⇒ off) ─────────────────────────────────────
Observability__Enabled=true                  # OpenTelemetry tracing
Observability__CaptureMessageContent=false   # true to capture prompts/tool args (dev only)

# ── Control panel (optional cookie login; blank password ⇒ open on the LAN) ─────
Panel__Username=admin                        # only used when a password is set
Panel__Password=

# ── Agentic browser (Playwright MCP; off by default) ───────────────────────────
Erda__Browser__Enabled=false
Erda__Browser__ShowWindow=false              # true (dev) to watch a real window; absent ⇒ headless
Erda__Browser__UserDataDir=/data/browser     # required when Enabled (dev: e.g. /tmp/erda-browser)
Erda__Browser__OutputDir=/media              # required when Enabled (dev: a local folder)
# Erda__Browser__Deployment=                 # optional: sub-agent model; blank ⇒ uses Erda__ChatDeployment
OP_SERVICE_ACCOUNT_TOKEN=                     # 1Password service-account token (read-only, Erda vault); optional

# ── Compose / deploy only (read by docker-compose.yml, NOT by the .NET app) ─────
# Host paths bind-mounted into the containers (absolute; ~ is NOT expanded). Jetson values shown.
CODEX_DIR=/home/phil/.codex                  # logged-in `codex login` session dir
VAULT_DIR=/home/phil/vault                   # host vault dir mounted at /vault
PANEL_BIND=0.0.0.0                           # host interface for the panel port (LAN IP to restrict)
OWNER_JID=490000000000@s.whatsapp.net        # bridge whitelist (JID form of your number)
