# Erda configuration — the single source of truth (env-only).
#
# Copy to .env (git-ignored). Both docker-compose (prod, via `env_file`) and `make dev` (which sources
# this file) read the SAME app-native keys below. NOTHING has an in-code default: every value here
# must be set, and a missing one stops the app at startup naming the key. Bool switches are OFF when
# absent — turn on what you want. Feature settings (WhatsApp, Upload, ErrorWatch, Reminders,
# AppleBridge) are required only when that feature's `Enabled` switch is on.
#
# Values here are the conventional ones / placeholders. Container paths (/vault, /media, /data) suit
# the Jetson deployment; on the dev Mac use real local paths. In Komodo, set these same keys as the
# Stack's environment/secrets.

# ── Credentials (required) ─────────────────────────────────────────────────────
# OpenAI-platform key for transcription only (the chat endpoint has no transcribe model). The chat
# model now runs against the local codex-oauth proxy — see Erda__ChatBaseUrl below.
OPENAI_API_KEY=

# ── Core (required) ────────────────────────────────────────────────────────────
Erda__VaultPath=/vault                       # Obsidian vault root (dev: /Users/you/Notes)
Erda__DbPath=/data/erda/erda.db              # SQLite state file (dev: an absolute local path)

# ── Models (required) ──────────────────────────────────────────────────────────
# The chat endpoint is the local codex-oauth proxy: an OpenAI-compatible surface exposing the
# ChatGPT-subscription models over plain HTTP. Erda talks to it via the Responses API (streamed).
Erda__ChatBaseUrl=http://127.0.0.1:10531/v1  # local codex-oauth proxy base URL (prod differs)
Erda__ChatModel=gpt-5.5                       # chat model served by the proxy
Erda__ChatReasoningEffort=high               # low / medium / high (drives both chat + reasoner)
# Erda__ChatApiKey=local                      # optional; the loopback proxy needs no auth (default: local)
Erda__TranscribeModel=gpt-4o-transcribe      # OpenAI STT model (gpt-4o-mini-transcribe is cheaper)
Erda__VoiceMemoSubfolder=VoiceMemos          # vault-relative folder for processed voice memos

# ── WhatsApp (Enabled is a switch; the four below are required only when Enabled=true) ──
WhatsApp__Enabled=true
WhatsApp__OwnerNumber=+490000000000          # your number, E.164
WhatsApp__BridgeUrl=http://whatsapp-bridge:8088   # dev: http://127.0.0.1:8088
WhatsApp__SharedSecret=                       # long random string; SAME value the bridge uses
WhatsApp__MediaTempDir=/media                # dev: /tmp/erda-bridge
# WhatsApp__DevPrefix=@dev                    # optional: only when running a dev instance alongside prod

# ── Upload (HTTP audio → same voice-memo pipeline; Enabled is a switch, requires WhatsApp__Enabled) ──
Upload__Enabled=false                         # POST /upload for an iOS Shortcut; reply goes back over WhatsApp
Upload__ApiKey=                               # bearer token (Authorization: Bearer <key>); required when Enabled
Upload__MaxUploadMb=50                        # reject bigger bodies with 413 (required when Enabled; 50 recommended)

# ── Apple Reminders + Calendar bridge (macOS ErdaBridge app; Enabled is a switch, the rest required when Enabled=true) ──
# One switch covers both capabilities — same app, same token, same address. Which of them actually
# work is decided on the Mac, by the two separate macOS permissions ErdaBridge asks for; an
# ungranted one comes back as a readable 503 through the tool rather than as a config error.
AppleBridge__Enabled=false
AppleBridge__BaseUrl=http://192.168.178.103:17832   # the Mac's LAN address — must match ErdaBridge's configured bind
                                                     # address exactly, and needs a DHCP reservation or it will drift
AppleBridge__ApiKey=                                 # bearer token shown once in ErdaBridge's setup UI
AppleBridge__TimeoutSeconds=5                        # HTTP timeout; the Mac may be asleep — fail fast (required when Enabled)

# ── Seq (optional; blank ServerUrl ⇒ error-watch + log shipping are off) ────────
Seq__ServerUrl=https://seq.example.com
Seq__ApiKey=
Seq__IngestToErda=true                       # ship Erda's own logs to Seq (switch; absent ⇒ off)

# ── Error watch (Enabled is a switch; the three below required only when Enabled=true) ──
ErrorWatch__Enabled=true
ErrorWatch__PollInterval=00:15:00            # how often to poll Seq (hh:mm:ss)
ErrorWatch__MinLevel=Error                   # minimum Seq level to alert on
ErrorWatch__MaxAlertsPerPoll=5               # per-poll cap (prevents alert storms)
ErrorWatch__AnalyzeWithCodex=true            # analyse each error with Codex vs. send raw (switch)
# ErrorWatch__ReAlertAfter=06:00:00          # optional: re-alert an ongoing error after this long (absent ⇒ alert once, ever)
# ErrorWatch__SignatureProperties=venue,error # optional: fold these properties into the signature (and show them) for constant-template events

# ── Chat health (Enabled is a switch; the two below required only when Enabled=true) ──
# Hourly probe of the local OpenAI proxy (Erda__ChatBaseUrl); WhatsApps Phil when it stops
# answering — shut down, logged out, or returning empty responses — and again when it recovers.
ChatHealth__Enabled=true
ChatHealth__CheckInterval=01:00:00           # how often to probe the chat endpoint (hh:mm:ss)
ChatHealth__Timeout=00:02:00                 # a probe with no answer in this long counts as down
# ChatHealth__ReAlertAfter=06:00:00          # optional: nag again while it stays down (absent ⇒ one alert per outage)

# ── Reminders (Enabled is a switch; settings below required only when Enabled=true) ──
Reminders__Enabled=true
Reminders__TimeZone=Europe/Berlin            # IANA timezone the `when` column is read in
Reminders__PollInterval=00:01:00             # how often to check for due reminders (hh:mm:ss)
Reminders__OverdueGrace=24:00:00             # how late a one-shot may still fire (e.g. after downtime)
Reminders__NotifyOnError=true                # WhatsApp note on a parse/dispatch failure (switch)
Reminders__PreScriptEnabled=true             # allow scheduled-prompt pre-run scripts (switch)
Reminders__PreScriptTimeout=00:00:30         # required when PreScriptEnabled: kill a script after this
Reminders__PreScriptMaxOutputChars=8000      # required when PreScriptEnabled: cap injected stdout

# ── Observability (switches; absent ⇒ off) ─────────────────────────────────────
Observability__Enabled=true                  # OpenTelemetry tracing
Observability__CaptureMessageContent=false   # true to capture prompts/tool args (dev only)

# ── Control panel (optional cookie login; blank password ⇒ open on the LAN) ─────
Panel__Username=admin                        # only used when a password is set
Panel__Password=

# ── Obsidian Sync sidecar (keeps the vault synced inside the stack; NOT read by the .NET app) ──
# The vault lives in a named docker volume kept in sync by the obsidian-sync container, so there is
# no host-side sync to set up. Bootstrap once: `docker compose run --rm obsidian-sync setup`.
OBSIDIAN_VAULT_NAME=My Vault                  # exact remote vault name in your Obsidian Sync account
OBSIDIAN_AUTH_TOKEN=                          # optional: non-interactive auth (skips `setup`'s login step)
# End-to-end-encrypted vaults: run the one-time `setup` (it prompts for the E2E password and persists
# the key into the obsidian-config volume); no env var needed.

# ── Host paths for docker-compose (NOT read by the .NET app; absolute, ~ not expanded) ──
PANEL_BIND=0.0.0.0                           # host interface for the panel port (LAN IP to restrict)

# ── WhatsApp bridge (separate Go app with its own config contract) ──────────────
# In PROD, compose passes these to the bridge container (it derives the bridge's SHARED_SECRET from
# WhatsApp__SharedSecret above). Running WhatsApp LOCALLY via `make dev-all`, the bridge instead loads
# its own whatsapp-bridge/.env — so set OWNER_JID + SHARED_SECRET there for local use.
OWNER_JID=490000000000@s.whatsapp.net        # bridge owner whitelist (JID form of your number)
