# Local dev secrets — real API keys go here, never committed
appsettings.Development.json

# Stack deploy secrets (docker-compose reads ./.env)
/.env

bin/
obj/
*.user
.vs/
.idea/
*.DotSettings.user

# macOS
.DS_Store

# WhatsApp bridge: session/auth, downloaded media, local env
whatsapp-bridge/whatsmeow-session.db*
whatsapp-bridge/.env
whatsapp-bridge/whatsapp-bridge
/tmp/erda-bridge/

# Error-watch scheduler local state
errorwatch-state.json

# Go build artifacts
*.test
docs/notes.md

# Control-panel SPA (web/): dependencies + Vite build output (built in the Docker image)
web/node_modules/
web/dist/
web/*.local
# Playwright MCP verification artifacts
.playwright-mcp/
panel-*.png

# Docker stack persistent state now lives in named volumes (not host dirs), so nothing to ignore there.
# Kept: the dev browser OutputDir writes to project-root media/.
/media/

# macOS Reminders bridge (Swift): build products and the assembled app bundle
macos-bridge/.build/
macos-bridge/*.app
