<Project Sdk="Microsoft.NET.Sdk">

  <!-- Host-agnostic business logic: configuration, persistence, services, scheduling, messaging.
       No ASP.NET and no Microsoft.Agents.AI (MAF) host — only the lightweight Microsoft.Extensions.AI
       abstractions (ChatMessage) needed by the IAgentResponder seam. -->

  <!-- The Web SDK exposes these as implicit usings; replicate the non-ASP.NET subset so the moved
       files compile unchanged (ILogger, IConfiguration, BackgroundService, IHostEnvironment, …). -->
  <ItemGroup>
    <Using Include="Microsoft.Extensions.Configuration" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Hosting" />
    <Using Include="Microsoft.Extensions.Logging" />
    <Using Include="System.Net.Http.Json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Cronos" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
    <PackageReference Include="OpenAI" />
    <PackageReference Include="Seq.Api" />
  </ItemGroup>

</Project>
