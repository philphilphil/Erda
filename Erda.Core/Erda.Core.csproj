<Project Sdk="Microsoft.NET.Sdk">

  <!-- Host-agnostic business logic: configuration, persistence, services, scheduling, messaging.
       No ASP.NET and no Microsoft.Agents.AI (MAF) host — only the lightweight Microsoft.Extensions.AI
       abstractions (ChatMessage) needed by the IAgentResponder seam. -->

  <!-- The Web SDK exposes these as implicit usings; replicate the non-ASP.NET subset so the moved
       files compile unchanged (ILogger, IConfiguration, BackgroundService, IHostEnvironment, …). -->
  <ItemGroup>
    <Using Include="Microsoft.Extensions.Configuration" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Hosting" />
    <Using Include="Microsoft.Extensions.Logging" />
    <Using Include="System.Net.Http.Json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Cronos" Version="0.13.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Pin the native SQLite binary forward of EF Core's transitive 2.1.11 (GHSA-2m69-gcr7-jv3q,
         high). Only the native lib package moves (its versions track the SQLite release, 3.50.3); the
         managed core/provider stay on EF Core's train and P/Invoke the stable sqlite3 C ABI. -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.50.3" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.7.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.9" />
    <PackageReference Include="OpenAI" Version="2.11.0" />
    <PackageReference Include="Seq.Api" Version="2025.2.2" />
  </ItemGroup>

</Project>
