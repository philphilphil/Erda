<Router AppAssembly="@typeof(Routes).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(PanelLayout)" />
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="@typeof(PanelLayout)">
            <div class="page-head"><h1>Not found</h1></div>
            <p class="muted">No page at this address. <a href="/panel">Go to Reminders</a>.</p>
        </LayoutView>
    </NotFound>
</Router>
