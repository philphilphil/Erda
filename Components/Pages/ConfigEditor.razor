@page "/panel/config"
@inject IConfiguration Config
@inject IDbContextFactory<ErdaDbContext> DbFactory
@inject IHostApplicationLifetime Lifetime

<div class="page-head">
    <h1>Config</h1>
    <div class="muted">Tune runtime settings. Changes are saved to the database and applied on the next restart.</div>
</div>

<div class="banner">
    @if (!string.IsNullOrEmpty(error))
    {
        @error
    }
    else if (restarting)
    {
        <text>Restarting… reload this page in a few seconds.</text>
    }
    else if (saved)
    {
        <text>Overrides saved — restart to apply.</text>
    }
    else
    {
        <text>Edits apply on restart. Use “Restart Erda” below after saving.</text>
    }
</div>

<div class="card">
    <h2>Settings</h2>
    @foreach (var item in Allowlist)
    {
        var effective = Config[item.Key];
        var hasOverride = overrides.ContainsKey(item.Key);
        <div class="field">
            <div class="label">
                @item.Label
                @if (!string.IsNullOrEmpty(item.Hint))
                {
                    <span class="muted" style="margin-left:.5rem; font-weight:400;">@item.Hint</span>
                }
                @if (hasOverride)
                {
                    <span class="muted" style="margin-left:.5rem; font-weight:400;">(current: @effective)</span>
                }
            </div>
            <input class="input" value="@edited[item.Key]" @oninput="e => edited[item.Key] = e.Value?.ToString()" />
        </div>
    }
    <div class="toolbar">
        <button class="btn btn-primary" @onclick="Save">Save overrides</button>
        <button class="btn btn-ghost" @onclick="ClearAll">Clear all overrides</button>
    </div>
</div>

<div class="card">
    <h2>Restart</h2>
    <div class="muted">Apply saved prompt and config changes by restarting Erda. The container comes back automatically (~a few seconds).</div>
    <div class="toolbar">
        <button class="btn btn-danger" @onclick="Restart" disabled="@restarting">Restart Erda</button>
    </div>
</div>

@code {
    private sealed record AllowlistItem(string Label, string Key, string Hint);

    private static readonly AllowlistItem[] Allowlist =
    {
        new("Codex reasoning effort", "Erda:CodexReasoningEffort", "low / medium / high"),
        new("Chat model deployment", "Erda:ChatDeployment", ""),
        new("Error-watch enabled", "ErrorWatch:Enabled", "true / false"),
        new("Error-watch min level", "ErrorWatch:MinLevel", "Error / Warning / …"),
        new("Error-watch max alerts/poll", "ErrorWatch:MaxAlertsPerPoll", "numeric"),
        new("Error-watch poll interval", "ErrorWatch:PollInterval", "00:05:00"),
        new("Reminders enabled", "Reminders:Enabled", "true / false"),
        new("Reminders poll interval", "Reminders:PollInterval", "00:01:00"),
        new("Reminders timezone", "Reminders:TimeZone", "Europe/Berlin"),
    };

    private Dictionary<string, string?> overrides = new();
    private Dictionary<string, string?> edited = new();
    private bool saved;
    private bool restarting;
    private string? error;

    protected override void OnInitialized()
    {
        Load();
    }

    private void Load()
    {
        try
        {
            using var db = DbFactory.CreateDbContext();
            overrides = db.ConfigOverrides.ToDictionary(c => c.Key, c => c.Value);

            edited = new Dictionary<string, string?>();
            foreach (var item in Allowlist)
            {
                edited[item.Key] = overrides.TryGetValue(item.Key, out var ov) ? ov : Config[item.Key];
            }
        }
        catch (Exception ex)
        {
            error = $"Failed to load overrides: {ex.Message}";
        }
    }

    private void Save()
    {
        error = null;
        saved = false;
        try
        {
            using var db = DbFactory.CreateDbContext();
            foreach (var item in Allowlist)
            {
                var key = item.Key;
                var value = edited.TryGetValue(key, out var v) ? v : null;
                var effective = Config[key];
                var existing = db.ConfigOverrides.FirstOrDefault(c => c.Key == key);

                var isDifferent = !string.Equals(value, effective, StringComparison.Ordinal);
                var isBlank = string.IsNullOrWhiteSpace(value);

                if (isDifferent && !isBlank)
                {
                    if (existing is null)
                    {
                        db.ConfigOverrides.Add(new ConfigOverride { Key = key, Value = value });
                    }
                    else
                    {
                        existing.Value = value;
                    }
                }
                else if (existing is not null)
                {
                    db.ConfigOverrides.Remove(existing);
                }
            }

            db.SaveChanges();
            Load();
            saved = true;
        }
        catch (Exception ex)
        {
            error = $"Failed to save: {ex.Message}";
        }
    }

    private void ClearAll()
    {
        error = null;
        saved = false;
        try
        {
            using var db = DbFactory.CreateDbContext();
            db.ConfigOverrides.RemoveRange(db.ConfigOverrides);
            db.SaveChanges();
            Load();
        }
        catch (Exception ex)
        {
            error = $"Failed to clear overrides: {ex.Message}";
        }
    }

    private void Restart()
    {
        error = null;
        saved = false;
        restarting = true;
        Lifetime.StopApplication();
    }
}
