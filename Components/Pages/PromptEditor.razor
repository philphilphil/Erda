@page "/panel/prompt"
@inject IPromptStore Prompts

<div class="page-head">
    <h1>System Prompt</h1>
    <div class="muted">Edit the agent's system prompt. Saving creates a new version; changes apply on the next restart (Config → Restart Erda).</div>
</div>

<div class="banner">
    @if (!string.IsNullOrEmpty(error))
    {
        @error
    }
    else if (saved)
    {
        <text>Saved version — restart to apply.</text>
    }
    else
    {
        <text>Saved edits apply after a restart — go to Config to restart Erda.</text>
    }
</div>

<div class="card">
    <h2>Editor</h2>
    <textarea class="textarea code" rows="20" @bind="editorContent" @bind:event="oninput"></textarea>
    <div class="muted">@editorContent.Length chars · ~@(editorContent.Length / 4) tokens</div>
    <div class="toolbar">
        <input class="input" style="max-width: 320px;" @bind="note" placeholder="change note (optional)" />
        <button class="btn btn-primary" @onclick="Save" disabled="@string.IsNullOrWhiteSpace(editorContent)">Save new version</button>
    </div>
</div>

<div class="card">
    <h2>Version history</h2>
    @if (versions.Count == 0)
    {
        <div class="empty">No versions yet.</div>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Created</th>
                    <th>Note</th>
                    <th></th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var version in versions)
                {
                    <tr>
                        <td>
                            @version.CreatedAtUtc.ToLocalTime().ToString("MMM d, HH:mm")
                            @if (version.IsActive)
                            {
                                <span class="badge badge-active">active</span>
                            }
                        </td>
                        <td>
                            @if (string.IsNullOrWhiteSpace(version.Note))
                            {
                                <span class="muted">—</span>
                            }
                            else
                            {
                                @version.Note
                            }
                        </td>
                        <td>
                            <button class="btn btn-sm btn-ghost" @onclick="() => LoadIntoEditor(version)">Load into editor</button>
                        </td>
                        <td>
                            <button class="btn btn-sm" @onclick="() => Restore(version)" disabled="@version.IsActive">Restore</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private string editorContent = "";
    private string note = "";
    private bool saved;
    private string? error;
    private IReadOnlyList<PromptVersion> versions = new List<PromptVersion>();

    protected override void OnInitialized()
    {
        Reload();
        var active = versions.FirstOrDefault(v => v.IsActive);
        editorContent = active?.Content ?? "";
    }

    private void Reload()
    {
        try
        {
            versions = Prompts.ListVersions();
        }
        catch (Exception ex)
        {
            error = $"Failed to load versions: {ex.Message}";
        }
    }

    private void Save()
    {
        if (string.IsNullOrWhiteSpace(editorContent))
            return;

        error = null;
        saved = false;
        try
        {
            Prompts.SaveNewVersion(editorContent, string.IsNullOrWhiteSpace(note) ? null : note);
            note = "";
            Reload();
            saved = true;
        }
        catch (Exception ex)
        {
            error = $"Failed to save: {ex.Message}";
        }
    }

    private void LoadIntoEditor(PromptVersion version)
    {
        saved = false;
        editorContent = version.Content;
    }

    private void Restore(PromptVersion version)
    {
        error = null;
        saved = false;
        try
        {
            Prompts.Activate(version.Id);
            Reload();
        }
        catch (Exception ex)
        {
            error = $"Failed to restore: {ex.Message}";
        }
    }
}
